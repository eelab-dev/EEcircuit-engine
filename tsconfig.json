{
  "include": ["src", "types", "test", "scripts/**/*.mts", "Docker/**/*.mts", "vite.config.mts", "playwright.config.ts"],
  "exclude": ["src/spice.ts", "src/spice.d.ts", "test/local/**", "Docker/build/**"],
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    /* Additional Options */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    /*"paths": {
      "react": ["./node_modules/preact/compat/"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react-dom/": ["./node_modules/preact/compat/*"]
    }*/
  }
}
